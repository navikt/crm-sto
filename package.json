{
    "private": true,
    "scripts": {
        "lint": "eslint **/lwc/** **/aura/**",
        "lint:fix": "eslint --fix **/lwc/** **/aura/**",
        "lint:lwc": "eslint **/lwc/**",
        "lint:aura": "eslint **/aura/**",
        "test": "npm run lint && npm run test:unit",
        "test:unit": "sfdx-lwc-jest",
        "test:unit:watch": "sfdx-lwc-jest --watch",
        "test:unit:debug": "sfdx-lwc-jest --debug",
        "test:unit:coverage": "sfdx-lwc-jest --coverage",
        "prettier": "prettier --write \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
        "prettier:verify": "prettier --list-different \"**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}\"",
        "postinstall": "node bin/check-version.js",
        "activateMock": "sf apex run -f post-scratch/activateMock.cls",
        "activateFamilyMock": "sf apex run -f post-scratch/activateFamilyMock.cls",
        "deactivateMock": "sf apex run -f post-scratch/deactivateMock.cls",
        "scratchRoutingSetup": "sf apex run -f post-scratch/serviceResource.cls && sf project deploy start --source-dir unpackaged/queues --source-dir unpackaged/assignmentRules --wait 10 && sf apex run -f post-scratch/scratchRoutingData.cls",
        "scratchSetup": "sf apex run -f post-scratch/scratchSetup.cls && sf apex run -f post-scratch/scratchFamilySharing.cls && npm run activateFamilyMock && sf apex run -f dummy-data/GenerateData.apex && npm run scratchRoutingSetup",
        "prepare": "husky install",
        "mac:build": "bash bin/install-scratch.sh"
    },
    "engines": {
        "node": ">= 16.0.0",
        "npm": ">= 8.4.0"
    },
    "devDependencies": {
        "@babel/core": "^7.21.4",
        "@babel/eslint-parser": "^7.21.3",
        "@locker/eslint-config-locker": "^0.20.6",
        "@navikt/aksel": "^8.18.0",
        "@prettier/plugin-xml": "^2.2.0",
        "@sa11y/jest": "^4.1.5",
        "@salesforce/eslint-config-lwc": "^3.5.2",
        "@salesforce/eslint-plugin-aura": "^2.1.0",
        "@salesforce/sfdx-lwc-jest": "^1.3.0",
        "eslint": "^8.53.0",
        "eslint-config-prettier": "^8.8.0",
        "husky": "^8.0.0",
        "jest-canvas-mock": "^2.5.0",
        "lint-staged": "^13.2.2",
        "prettier": "^3.5.1",
        "prettier-plugin-apex": "^2.2.4",
        "semver": "^7.7.2"
    },
    "husky": {
        "hooks": {
            "pre-commit": "lint-staged"
        }
    },
    "lint-staged": {
        "**/*.{cls,cmp,component,css,html,js,json,md,page,trigger,xml,yaml,yml}": [
            "prettier --write"
        ],
        "**/{aura|lwc}/**": [
            "eslint"
        ]
    },
    "dependencies": {
        "@navikt/ds-css": "^8.18.0",
        "@navikt/ds-react": "^8.18.0"
    }
}
